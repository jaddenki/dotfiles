// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)

{
  "cli_default_open_behavior": "new_window",
  "show_edit_predictions": false,
  "completions": {
    "words": "fallback"
  },
  "disable_ai": false,
  "project_panel": {
    "git_status": true,
    "file_icons": true,
    "dock": "left"
  },
  "ui_font_family": "Aeonik",
  "buffer_font_family": "JetBrains Mono",
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "gpt-5.6-sol",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "vim_mode": true,
   "cursor_animation": {
     "enabled": true
   },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "build",
        "model": "openai/gpt-6.1-sol"
      },
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]",
        "mode": "auto"
      },
      "type": "registry"
    }
  },
  "base_keymap": "Cursor",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "jamms light",
    "dark": "jamms dark"
  },
  "languages": {
    "Java": {
      "show_edit_predictions": false,
      "show_completions_on_input": false,
      "completions": { "words": "disabled", "lsp": false }
    },
    "ANTLR4": {
      "show_edit_predictions": false,
      "show_completions_on_input": false,
      "completions": { "words": "disabled", "lsp": false }
    }
  },
    "format_on_save": "off",
    "remove_trailing_whitespace_on_save": true,
}
